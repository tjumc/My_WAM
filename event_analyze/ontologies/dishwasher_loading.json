  "semantic_classes": {
    "utensil": {
      "members": [
        "knife",
        "fork"
      ],
      "policy_equivalent": true,
      "target": "cutlery_basket",
      "preferred_training_label": "place_utensil_in_cutlery_basket",
      "training_label_policy": "parent",
      "allow_parent_held_evidence": true,
      "description": "Knife and fork are policy-equivalent for this task; training supervision prefers the reliable parent class."
    },
    "portable_object": {
      "members": [
        "utensil",
        "plate"
      ],
      "fallback_label_template": "place_object_in_receptacle"
    }
  },
  "skill_labels": {
    "navigate_to_station": {
      "zh": "移动到桌面/洗碗机前",
      "en": "Move to the table/dishwasher station"
    },
    "open_dishwasher_door": {
      "zh": "右手打开洗碗机门",
      "en": "Open the dishwasher door with the right hand"
    },
    "close_dishwasher_door": {
      "zh": "右手合上洗碗机门",
      "en": "Close the dishwasher door with the right hand"
    },
    "pull_out_dish_rack": {
      "zh": "右手拉出碗篮",
      "en": "Pull out the dish rack with the right hand"
    },
    "push_in_dish_rack": {
      "zh": "右手推入碗篮",
      "en": "Push in the dish rack with the right hand"
    },
    "pull_out_cutlery_basket": {
      "zh": "右手拉出餐具篮",
      "en": "Pull out the cutlery basket with the right hand"
    },
    "push_in_cutlery_basket": {
      "zh": "右手推入餐具篮",
      "en": "Push in the cutlery basket with the right hand"
    },
    "place_knife_in_cutlery_basket": {
      "zh": "右手夹取刀并放入餐具篮",
      "en": "Pick up the knife and place it in the cutlery basket with the right hand"
    },
    "place_fork_in_cutlery_basket": {
      "zh": "右手夹取叉子并放入餐具篮",
      "en": "Pick up the fork and place it in the cutlery basket with the right hand"
    },
    "place_utensil_in_cutlery_basket": {
      "zh": "右手夹取餐具并放入餐具篮",
      "en": "Pick up the utensil and place it in the cutlery basket with the right hand"
    },
    "place_plate_in_dish_rack": {
      "zh": "右手夹取盘子并放入碗篮",
      "en": "Pick up the plate and place it in the dish rack with the right hand"
    },
    "place_object_in_receptacle": {
      "zh": "夹取物体并放入目标容器",
      "en": "Pick up the object and place it in the target receptacle"
    }
  },
  "label_backoff": [
    {
      "fine_classes": [
        "knife",
        "fork"
      ],
      "parent": "utensil",
      "condition": "fine_identity_not_reliable_but_parent_relation_reliable"
    },
    {
      "fine_classes": [
        "utensil",
        "plate"
      ],
      "parent": "portable_object",
      "condition": "object_class_not_reliable_but_manipulation_relation_reliable"
    }
  ],
  "notes": [
    "Task-family schema may be defined once with human assistance; per-trajectory inference remains automatic.",
    "Knife/fork distinction is retained as optional diagnostic evidence, while the preferred training label is the policy-equivalent parent class utensil."
  ],
  "manipulation_policy": {
    "max_concurrent_portable_objects": 1,
    "allow_inferred_parent_ownership": true,
    "direct_ownership_min_confidence": 0.7,
    "description": "This task family is annotated as sequential single-object portable manipulation. Change this for genuinely concurrent/bimanual task families."
  }
}
